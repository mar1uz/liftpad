http:// {
	reverse_proxy lift:3000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}
}

http://liftpad.xyz, http://www.liftpad.xyz {
	redir https://liftpad.xyz{uri} permanent
}

www.liftpad.xyz {
	redir https://liftpad.xyz{uri} permanent
}

liftpad.xyz {
	reverse_proxy lift:3000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}
}

