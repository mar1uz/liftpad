NODE_ENV=production
RPC_SOLANA=https://api.mainnet-beta.solana.com
RPC_BASE=https://mainnet.base.org
RPC_BSC=https://bsc-dataseed.binance.org
RPC_HYPEREVM=https://rpc.hyperliquid.xyz/evm
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
RPC_ARC=https://rpc.mainnet.arc.io
RPC_NEAR=https://free.rpc.fastnear.com
LAUNCHLAB_PLATFORM_ID=4WYB7yp3fv9KNuTJgPAFsSVrU1SxLHjEjmyJbvFMMmqG

# Mobile Solana + EVM: WalletConnect (Reown AppKit) is PRIMARY — session stays in Chrome.
# Create a free project at https://dashboard.reown.com and paste the Project ID.
# Native Phantom deeplink (ul/v1/connect) is secondary fallback only. Do NOT use ul/browse.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Daily market snapshots (migration 003 + market-snapshot Edge Function).
# Server-side only; never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# NEAR (network #8). NEXT_PUBLIC_* are build-time (Docker build args) and read by the server too.
# Launches stay disabled until NEXT_PUBLIC_NEAR_TREASURY is a real LIFT NEAR account (e.g. liftpad.near).
NEXT_PUBLIC_NEAR_NETWORK=mainnet
NEXT_PUBLIC_NEAR_TREASURY=
NEXT_PUBLIC_NEAR_LAUNCH_FEE=0.1
# Optional overrides (defaults: tkn.near / v2.ref-finance.near / wrap.near; testnet: tokenfactory.testnet / ref-finance-101.testnet / wrap.testnet)
NEXT_PUBLIC_NEAR_TOKEN_FACTORY=
NEXT_PUBLIC_NEAR_REF_EXCHANGE=
NEXT_PUBLIC_NEAR_WRAP=
